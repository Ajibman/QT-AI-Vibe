# ios/fastlane/Fastfile
default_platform(:ios)

platform :ios do
  desc "Push a new build to Apple TestFlight"
  lane :beta do
    # Pulls certificates securely from your private repository
    sync_code_signing(type: "appstore") 
    
    # Builds the iOS .ipa binary using Xcode tools
    build_app(workspace: "YourApp.xcworkspace", scheme: "YourApp")
    
    # Uploads directly to App Store Connect using your Apple API Key
    upload_to_testflight(api_key_path: "fastlane/api_key.json")
  end
end
